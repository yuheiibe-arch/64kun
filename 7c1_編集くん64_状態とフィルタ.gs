/**
 * ============================================================================
 * 7c1_編集くん64_状態とフィルタ.gs
 * （同時間帯ロック解除「AまたはB交渉」＆ 個別交渉時の特別時給加算オプション管理対応版）
 * ============================================================================
 */

function getHenshukun64ScriptPart1_() {
  return [
    'let state = {',
    '  sessionId: "",',
    '  myStaff: "",',
    '  macroMode: "ALL",',
    '  selectedRegions: new Set(),',
    '  activeDateTab: "",',
    '  staffList: [],',
    '  doctorSearchList: [],',
    '  backupDocsByDate: {},',
    '  groups: [],',
    '  areaToGroups: {},',
    '  slotRows: [],',
    '  bundleRows: [],',
    '  activeLocks: {},',
    '  changedSlots: {},',
    '  changedBundles: {},',
    '  unlockedConflicts: {},', // slotKey -> true（同時間帯・移動競合をあえてロック解除して「AまたはB」交渉するフラグ）
    '  unlockedExtraSpWage: {}', // slotKey -> true（既に特別時給の枠であえてさらに加算ロックを解除したフラグ）
    '};',
    '',
    'const DECISION_PRESETS = ["", "案1", "案2", "案3", "案1, 案2", "案1, 案3", "案2, 案3", "全案", "バックアップ医師に勤務依頼", "ステイ", "特別時給＋ステイ", "カスタム入力"];',
    'const SPECIAL_STAY_AMOUNTS = ["+2,000円", "+3,000円", "+4,000円", "+5,000円"];',
    'const CUSTOM_ACTION_TYPES = ["個別打診", "移動打診", "延長打診", "早出打診"];',
    '',
    'function parseMultiDoctorPlansFromCol2_64(col2Text) {',
    '  const result = {};',
    '  String(col2Text || "").split("\\n").forEach(function(line) {',
    '    const m = line.trim().match(/^【案([123])】(.*)$/);',
    '    if (!m) return;',
    '    const planNum = m[1];',
    '    const body = m[2];',
    '    const pairMatch = body.match(/①\\s*([^\\s\\[（\\(\\/／]+?)先生[^\\/／]*[\\/／]\\s*②\\s*([^\\s\\[（\\)\\）\\/／]+?)先生/);',
    '    if (pairMatch) {',
    '      result[planNum] = {',
    '        doc1: pairMatch[1].trim(),',
    '        doc2: pairMatch[2].trim()',
    '      };',
    '    }',
    '  });',
    '  return result;',
    '}',
    '',
    '// ★確定案文字列から「【特別時給+2,000円交渉】」や「【特別時給さらに+2,000円加算交渉】」のタグを除去した純粋な案文字列を返す',
    'function stripNegotiationSpWageTag64(dec) {',
    '  return String(dec || "").replace(/【特別時給(?:さらに)?(\\+\\d,\\d{3}円|\\+\\d{4}円)(?:加算)?交渉】/g, "").trim();',
    '}',
    '',
    '// ★確定案文字列に特別時給交渉タグが含まれているかを判定し、その金額（例: "+2,000円"）を抽出',
    'function extractNegotiationSpWageInfo64(dec) {',
    '  const s = String(dec || "");',
    '  const m = s.match(/【特別時給(?:さらに)?(\\+\\d,\\d{3}円|\\+\\d{4}円)(?:加算)?交渉】/);',
    '  if (!m) return { enabled: false, amount: "+2,000円" };',
    '  return { enabled: true, amount: SPECIAL_STAY_AMOUNTS.includes(m[1]) ? m[1] : "+2,000円" };',
    '}',
    '',
    'function normalizeBasePresetDecision64(curDec) {',
    '  const s = stripNegotiationSpWageTag64(curDec);',
    '  if (!s || s === "要検討") return "";',
    '  if (isSpecialStayDecision64(s)) return "特別時給＋ステイ";',
    '  if (isBackupDecision64(s)) return "バックアップ医師に勤務依頼";',
    '  const stripped = s.replace(/\\((?:①|②|医師未選択)[^)]*\\)/g, "").trim();',
    '  if (DECISION_PRESETS.includes(stripped)) return stripped;',
    '  return "カスタム入力";',
    '}',
    '',
    'function extractPickedSubDocForPlan64(curDec, planNum) {',
    '  const s = stripNegotiationSpWageTag64(curDec);',
    '  const re = new RegExp("案" + planNum + "\\\\(([^)]+)\\\\)");',
    '  const m = s.match(re);',
    '  if (!m) return "";',
    '  return m[1] === "医師未選択" ? "" : m[1];',
    '}',
    '',
    'function isBackupDecision64(dec) {',
    '  return stripNegotiationSpWageTag64(dec).indexOf("バックアップ医師に勤務依頼") === 0;',
    '}',
    '',
    'function getSlotBand64(timeAndWage) {',
    '  const s = String(timeAndWage || "");',
    '  const m = s.match(/(\\d{1,2}):(\\d{2})\\s*[\\-〜～~]\\s*(\\d{1,2}):(\\d{2})/);',
    '  if (!m) return "A";',
    '  const sh = Number(m[1]);',
    '  if (sh < 13) return "A";',
    '  if (sh < 18) return "B";',
    '  return "C";',
    '}',
    '',
    'function getAvailableBackupDoctorsForRow64(row) {',
    '  if (row.macroArea !== "関東") return [];',
    '  const dayObj = state.backupDocsByDate[row.sortDate];',
    '  if (!dayObj) return [];',
    '',
    '  const band = getSlotBand64(row.timeAndWage);',
    '  const bandDocs = dayObj[band] || [];',
    '  if (bandDocs.length === 0) return [];',
    '',
    '  const otherSameBandRows = state.slotRows.filter(function(r) {',
    '    return r.sortDate === row.sortDate && r.slotKey !== row.slotKey && getSlotBand64(r.timeAndWage) === band && isBackupDecision64(r.curDecision);',
    '  });',
    '',
    '  let usedCount = otherSameBandRows.length;',
    '',
    '  if (band === "B" || band === "C") {',
    '    const adjBand = (band === "B") ? "C" : "B";',
    '    const adjDocs = dayObj[adjBand] || [];',
    '    const overlapDocsCount = bandDocs.filter(function(d) {',
    '      return adjDocs.some(function(ad) { return ad.norm === d.norm; });',
    '    }).length;',
    '',
    '    if (overlapDocsCount > 0) {',
    '      const otherClinicAdjRows = state.slotRows.filter(function(r) {',
    '        return r.sortDate === row.sortDate &&',
    '               r.slotKey !== row.slotKey &&',
    '               getSlotBand64(r.timeAndWage) === adjBand &&',
    '               r.clinicNameClean !== row.clinicNameClean &&',
    '               isBackupDecision64(r.curDecision);',
    '      });',
    '',
    '      const nonOverlapInAdj = Math.max(0, adjDocs.length - overlapDocsCount);',
    '      const consumedOverlap = Math.max(0, otherClinicAdjRows.length - nonOverlapInAdj);',
    '      usedCount += consumedOverlap;',
    '    }',
    '  }',
    '',
    '  const remainCount = bandDocs.length - usedCount;',
    '  if (remainCount <= 0) return [];',
    '  return bandDocs.slice(usedCount);',
    '}',
    '',
    'function canShowBackupOptionForRow64(row) {',
    '  if (row.macroArea !== "関東") return false;',
    '  if (isBackupDecision64(row.curDecision)) return true;',
    '  return getAvailableBackupDoctorsForRow64(row).length > 0;',
    '}',
    '',
    'function isSpecialStayDecision64(dec) {',
    '  const s = stripNegotiationSpWageTag64(dec);',
    '  return s === "特別時給＋ステイ" || (/^特別時給.*ステイ$/.test(s));',
    '}',
    '',
    'function isStayLikeDecision64(dec) {',
    '  const s = stripNegotiationSpWageTag64(dec);',
    '  return s === "ステイ" || isSpecialStayDecision64(s);',
    '}',
    '',
    'function extractSpecialStayAmount64(dec) {',
    '  const s = stripNegotiationSpWageTag64(dec);',
    '  const m = String(s || "").match(/\\+(\\d,\\d{3}円|\\d{4}円)/);',
    '  if (!m) return "+2,000円";',
    '  const raw = m[1].indexOf(",") === -1 ? m[1].replace(/^(\\d)(\\d{3})/, "$1,$2") : m[1];',
    '  const full = "+" + raw;',
    '  return SPECIAL_STAY_AMOUNTS.includes(full) ? full : "+2,000円";',
    '}',
    '',
    'window.onload = function() {',
    '  reloadAllData();',
    '  setInterval(sendHeartbeat64, 15000);',
    '  document.addEventListener("click", function(e) {',
    '    if (!e.target.closest(".custom-builder")) {',
    '      document.querySelectorAll(".suggest-dropdown").forEach(function(el) { el.style.display = "none"; });',
    '    }',
    '  });',
    '};',
    '',
    'function normalizeSearchClient64(str) {',
    '  return String(str || "")',
    '    .replace(/[\\s\\u3000]+/g, "")',
    '    .replace(/[﨑嵜]/g, "崎").replace(/髙/g, "高").replace(/[瀧泷]/g, "滝")',
    '    .replace(/[邊邉]/g, "辺").replace(/[齋齊斉]/g, "斎").replace(/澤/g, "沢")',
    '    .replace(/廣/g, "広").replace(/國/g, "国").replace(/[嶋嶌]/g, "島")',
    '    .replace(/[栁柳]/g, "柳").replace(/[濵濱]/g, "浜").replace(/櫻/g, "桜")',
    '    .replace(/眞/g, "真").replace(/惠/g, "恵").replace(/[壽寿]/g, "寿")',
    '    .replace(/[靜静]/g, "静").replace(/[榮栄]/g, "栄").replace(/[彌弥]/g, "弥")',
    '    .replace(/[祐裕]/g, "祐").replace(/[佳圭]/g, "佳").replace(/[智知]/g, "智")',
    '    .trim();',
    '}',
    '',
    'function reloadAllData() {',
    '  setStatus("⏳ データを読み込んでいます...", "#ffc72c");',
    '  google.script.run',
    '    .withSuccessHandler(initStudio64)',
    '    .withFailureHandler(function(err) { setStatus("❌ 読込エラー: " + err.message, "#ff5252"); })',
    '    .getHenshukunInitialData();',
    '}',
    '',
    'function initStudio64(data) {',
    '  if (!state.sessionId) state.sessionId = data.clientSessionId;',
    '  state.staffList = data.staffList || [];',
    '  state.doctorSearchList = data.doctorSearchList || [];',
    '  state.backupDocsByDate = data.backupDocsByDate || {};',
    '  state.groups = data.groups || [];',
    '  state.areaToGroups = data.areaToGroups || {};',
    '  state.slotRows = data.slotRows || [];',
    '  state.bundleRows = data.bundleRows || [];',
    '  state.activeLocks = data.activeLocks || {};',
    '',
    '  document.getElementById("docLinkBox").innerHTML =',
    '    "<a class=\\"doc-link\\" href=\\"" + data.docUrl + "\\" target=\\"_blank\\">📄 " + data.docName + " を別タブで開く</a>";',
    '',
    '  renderStaffSelectors();',
    '  renderRegionChips();',
    '',
    '  const dates = getFilteredUniqueDates();',
    '  if (!state.activeDateTab && dates.length > 0) {',
    '    state.activeDateTab = dates[0];',
    '  }',
    '  renderDateTabs();',
    '  renderStageTable();',
    '  renderBundlesTable();',
    '  updateActivePlayersDisplay();',
    '  updateEditCounter();',
    '  setStatus("✅ 読み込み完了！（医師マスタ " + state.doctorSearchList.length + " 名検索可能）", "#69f0ae");',
    '}',
    '',
    'function isSlotDecided64(row) {',
    '  const dec = stripNegotiationSpWageTag64(row.curDecision);',
    '  const stf = String(row.curAssignee || "").trim();',
    '  if (!dec || dec === "要検討" || dec.includes("医師未選択")) return false;',
    '  if (isStayLikeDecision64(dec)) return true;',
    '  return Boolean(stf && stf !== "(未定)" && stf !== "未定");',
    '}',
    '',
    'function getLockedStaffSetByOthers() {',
    '  const locked = new Set();',
    '  Object.entries(state.activeLocks || {}).forEach(function(entry) {',
    '    const sid = entry[0], info = entry[1];',
    '    if (sid !== state.sessionId && info.staff) locked.add(info.staff);',
    '  });',
    '  return locked;',
    '}',
    '',
    'function renderStaffSelectors() {',
    '  const lockedByOthers = getLockedStaffSetByOthers();',
    '  const buildOptions = function(selectedVal, isMySelector) {',
    '    let head = isMySelector',
    '      ? "<option value=\\"\\">-- 作業者を選択 --</option>"',
    '      : "<option value=\\"\\">(未定)</option>" +',
    '        "<option value=\\"担当者未定\\"" + (selectedVal === "担当者未定" ? " selected" : "") + ">担当者未定</option>";',
    '    return head + state.staffList.map(function(s) {',
    '      const isLocked = lockedByOthers.has(s);',
    '      const sel = (s === selectedVal) ? " selected" : "";',
    '      const dis = (isMySelector && isLocked) ? " disabled" : "";',
    '      const label = isLocked ? "🔒 " + s + " (作業中)" : s;',
    '      return "<option value=\\"" + s + "\\"" + sel + dis + ">" + label + "</option>";',
    '    }).join("");',
    '  };',
    '  const curBulkVal = document.getElementById("bulkStaffSelect") ? document.getElementById("bulkStaffSelect").value : state.myStaff;',
    '  document.getElementById("myPlayerSelect").innerHTML = buildOptions(state.myStaff, true);',
    '  document.getElementById("bulkStaffSelect").innerHTML = buildOptions(curBulkVal || state.myStaff, false);',
    '}',
    '',
    'function onMyPlayerChange() {',
    '  const picked = document.getElementById("myPlayerSelect").value;',
    '  state.myStaff = picked;',
    '  document.getElementById("bulkStaffSelect").value = picked;',
    '  sendHeartbeat64();',
    '}',
    '',
    'function sendHeartbeat64() {',
    '  if (!state.sessionId) return;',
    '  google.script.run',
    '    .withSuccessHandler(function(res) {',
    '      if (!res.ok && res.conflictStaff) {',
    '        alert("⚠️ 「" + res.conflictStaff + "」さんは現在別画面で作業中のためブロックされています！");',
    '        state.myStaff = "";',
    '        document.getElementById("myPlayerSelect").value = "";',
    '      }',
    '      state.activeLocks = res.activeLocks || {};',
    '      let syncedChanged = false;',
    '      if (res.latestDraft && res.latestDraft.slots) {',
    '        state.slotRows.forEach(function(r) {',
    '          const d = res.latestDraft.slots[r.slotKey];',
    '          if (d && !state.changedSlots[r.slotKey]) {',
    '            const newCmnt = String(d.customComment || "");',
    '            if (r.curDecision !== d.decision || r.curAssignee !== d.assignee || (r.customComment || "") !== newCmnt) {',
    '              r.curDecision = d.decision;',
    '              r.curAssignee = d.assignee;',
    '              r.customComment = newCmnt;',
    '              r.customDocs = Array.isArray(d.customDocs) ? d.customDocs : [];',
    '              syncedChanged = true;',
    '            }',
    '          }',
    '        });',
    '      }',
    '      renderStaffSelectors();',
    '      updateActivePlayersDisplay();',
    '      if (syncedChanged) {',
    '        renderDateTabs();',
    '        renderStageTable();',
    '        updateEditCounter();',
    '      }',
    '    })',
    '    .heartbeatHenshukunPlayer(state.sessionId, state.myStaff);',
    '}',
    '',
    'function updateActivePlayersDisplay() {',
    '  const names = Object.values(state.activeLocks || {}).map(function(x) { return x.staff; }).filter(Boolean);',
    '  const el = document.getElementById("activePlayersText");',
    '  el.innerText = names.length > 0 ? "🟢 作業中: " + names.join(" / ") : "🟢 重複作業なし";',
    '}',
    '',
    'function setMacroMode(mode) {',
    '  state.macroMode = mode;',
    '  ["ALL", "関東", "関西"].forEach(function(m) {',
    '    const btn = document.getElementById("mode_" + m);',
    '    if (btn) btn.classList.toggle("active-mode", m === mode);',
    '  });',
    '  state.selectedRegions.clear();',
    '  renderRegionChips();',
    '  const dates = getFilteredUniqueDates();',
    '  if (state.activeDateTab !== "BUNDLES" && !dates.includes(state.activeDateTab)) {',
    '    state.activeDateTab = dates[0] || "";',
    '  }',
    '  renderDateTabs();',
    '  renderStageTable();',
    '  updateEditCounter();',
    '}',
    '',
    'function renderRegionChips() {',
    '  let targetGroups = state.groups;',
    '  if (state.macroMode !== "ALL" && state.areaToGroups[state.macroMode]) {',
    '    targetGroups = state.areaToGroups[state.macroMode];',
    '  }',
    '  const html = targetGroups.map(function(g) {',
    '    const isSel = state.selectedRegions.has(g);',
    '    return "<span class=\\"chip" + (isSel ? " selected" : "") + "\\" onclick=\\"toggleRegionChip(\'" + g + "\')\\">" +',
    '      (isSel ? "✓ " : "") + g + "</span>";',
    '  }).join("");',
    '  document.getElementById("regionChipsBox").innerHTML = html;',
    '}',
    '',
    'function toggleRegionChip(groupName) {',
    '  if (state.selectedRegions.has(groupName)) state.selectedRegions.delete(groupName);',
    '  else state.selectedRegions.add(groupName);',
    '  renderRegionChips();',
    '  const dates = getFilteredUniqueDates();',
    '  if (state.activeDateTab !== "BUNDLES" && !dates.includes(state.activeDateTab)) {',
    '    state.activeDateTab = dates[0] || "";',
    '  }',
    '  renderDateTabs();',
    '  renderStageTable();',
    '  updateEditCounter();',
    '}',
    '',
    'function clearRegionSelection() {',
    '  state.selectedRegions.clear();',
    '  renderRegionChips();',
    '  renderDateTabs();',
    '  renderStageTable();',
    '  updateEditCounter();',
    '}',
    '',
    'function isRowMatchRegionFilter(row) {',
    '  if (state.macroMode !== "ALL" && row.macroArea !== state.macroMode) return false;',
    '  if (state.selectedRegions.size > 0 && !state.selectedRegions.has(row.clinicGroup)) return false;',
    '  return true;',
    '}',
    '',
    'function getFilteredUniqueDates() {',
    '  const set = new Set();',
    '  state.slotRows.forEach(function(r) { if (isRowMatchRegionFilter(r)) set.add(r.dateLabel); });',
    '  return Array.from(set);',
    '}',
    '',
    'function renderDateTabs() {',
    '  const dates = getFilteredUniqueDates();',
    '  const tabsHtml = dates.map(function(d) {',
    '    const dayRows = state.slotRows.filter(function(r) { return r.dateLabel === d && isRowMatchRegionFilter(r); });',
    '    const decided = dayRows.filter(isSlotDecided64).length;',
    '    const isAct = (state.activeDateTab === d);',
    '    return "<div class=\\"date-tab" + (isAct ? " active" : "") + "\\" onclick=\\"selectStageTab(\'" + d + "\')\\">" +',
    '      "<span>📅 " + d + "</span><span class=\\"tab-count\\">" + decided + "/" + dayRows.length + "枠</span></div>";',
    '  });',
    '  if (state.bundleRows && state.bundleRows.length > 0) {',
    '    const isBundleAct = (state.activeDateTab === "BUNDLES");',
    '    tabsHtml.push(',
    '      "<div class=\\"date-tab" + (isBundleAct ? " active" : "") + "\\" onclick=\\"selectStageTab(\'BUNDLES\')\\">" +',
    '      "<span>🌟 複数日程おまとめ打診</span><span class=\\"tab-count\\">" + state.bundleRows.length + "名</span></div>"',
    '    );',
    '  }',
    '  document.getElementById("dateTabsBar").innerHTML = tabsHtml.join("");',
    '}',
    '',
    'function selectStageTab(tabKey) {',
    '  state.activeDateTab = tabKey;',
    '  renderDateTabs();',
    '  if (tabKey === "BUNDLES") {',
    '    document.getElementById("slotsStageView").style.display = "none";',
    '    document.getElementById("bundlesStageView").style.display = "block";',
    '  } else {',
    '    document.getElementById("slotsStageView").style.display = "block";',
    '    document.getElementById("bundlesStageView").style.display = "none";',
    '    renderStageTable();',
    '  }',
    '}'
  ].join('\n');
}