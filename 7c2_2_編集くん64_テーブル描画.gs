    '}',
    '',
    'function buildPickedDocsTagsHtml64(slotKey, customDocs) {',
    '  if (!Array.isArray(customDocs) || customDocs.length === 0) return "";',
    '  return customDocs.map(function(d, idx) {',
    '    const licLabel = d.licenseNo ? " (医籍:" + d.licenseNo + ")" : " (番号未登録)";',
    '    return "<span class=\\"picked-doc-tag\\">" +',
    '      "🆔 " + d.name + licLabel +',
    '      "<span class=\\"del-btn\\" title=\\"削除\\" onclick=\\"removeCustomDoc64(\'" + slotKey + "\'," + idx + ")\\">×</span>" +',
    '    "</span>";',
    '  }).join("");',
    '}',
    '',
    '// ★個別交渉時の「💰特別時給で交渉する」チェック＆加算額選択ボックスHTMLの組み立て',
    '// ・通常時給の枠：そのままチェックして +2,000円〜+5,000円 を選択可能',
    '// ・既に特別時給の枠：初期状態はロック（🔒既に特別時給枠）されており、「🔓さらに加算を許可」ボタンを押すと加算選択が可能になる',
    'function buildNegotiationSpWageBoxHtml64(row) {',
    '  const curDec = String(row.curDecision || "").trim();',
    '  const baseSel = normalizeBasePresetDecision64(curDec);',
    '  const isPitchSelected = Boolean(baseSel && !isStayLikeDecision64(baseSel));',
    '  const isAlreadySpSlot = String(row.timeAndWage || "").includes("特別時給");',
    '  const isExtraUnlocked = Boolean(state.unlockedExtraSpWage && state.unlockedExtraSpWage[row.slotKey]);',
    '  const negSpInfo = extractNegotiationSpWageInfo64(curDec);',
    '',
    '  const amtOpts = SPECIAL_STAY_AMOUNTS.map(function(amt) {',
    '    const lbl = isAlreadySpSlot ? ("さらに " + amt + " 加算") : ("特別時給 " + amt);',
    '    return "<option value=\\"" + amt + "\\"" + (amt === negSpInfo.amount ? " selected" : "") + ">" + lbl + "</option>";',
    '  }).join("");',
    '',
    '  // 既に特別時給の枠で、まだロック解除されていない場合',
    '  if (isAlreadySpSlot && !isExtraUnlocked) {',
    '    return "<div id=\\"negsp_wrap_" + row.slotKey + "\\" style=\\"display:" + (isPitchSelected ? "block" : "none") + ";margin-top:5px;padding:5px 7px;background:#f1f5f9;border:1.5px solid #94a3b8;border-radius:6px;\\">" +',
    '      "<div style=\\"display:flex;align-items:center;justify-content:space-between;gap:4px;\\">" +',
    '        "<span style=\\"font-size:11px;font-weight:bold;color:#475569;\\">🔒 既に特別時給枠（加算ロック中）</span>" +',
    '        "<button type=\\"button\\" class=\\"btn-64\\" style=\\"background:#d97706;font-size:10px;padding:2px 6px;\\" onclick=\\"toggleExtraSpWageUnlock64(\'" + row.slotKey + "\')\\">🔓 さらに加算</button>" +',
    '      "</div>" +',
    '    "</div>";',
    '  }',
    '',
    '  const chkLabel = isAlreadySpSlot ? "💰 特別時給をさらに加算して交渉" : "💰 特別時給で交渉する";',
    '  const lockBackBtn = isAlreadySpSlot',
    '    ? "<button type=\\"button\\" class=\\"btn-64\\" style=\\"background:#64748b;font-size:10px;padding:1px 5px;margin-left:auto;\\" onclick=\\"toggleExtraSpWageUnlock64(\'" + row.slotKey + "\')\\">🔒 ロック戻す</button>"',
    '    : "";',
    '',
    '  return "<div id=\\"negsp_wrap_" + row.slotKey + "\\" style=\\"display:" + (isPitchSelected ? "block" : "none") + ";margin-top:5px;padding:5px 7px;background:" + (negSpInfo.enabled ? "#fef3c7" : "#f8fafc") + ";border:2px solid " + (negSpInfo.enabled ? "#f59e0b" : "#94a3b8") + ";border-radius:6px;\\">" +',
    '    "<div style=\\"display:flex;align-items:center;gap:5px;\\">" +',
    '      "<label style=\\"display:flex;align-items:center;gap:4px;cursor:pointer;font-size:11.5px;font-weight:900;color:#b45309;\\">" +',
    '        "<input type=\\"checkbox\\" id=\\"negsp_chk_" + row.slotKey + "\\"" + (negSpInfo.enabled ? " checked" : "") + " onchange=\\"onSlotEdit64(\'" + row.slotKey + "\')\\" style=\\"width:15px;height:15px;cursor:pointer;\\">" +',
    '        chkLabel +',
    '      "</label>" +',
    '      lockBackBtn +',
    '    "</div>" +',
    '    "<div id=\\"negsp_amtbox_" + row.slotKey + "\\" style=\\"display:" + (negSpInfo.enabled ? "block" : "none") + ";margin-top:4px;\\">" +',
    '      "<select class=\\"n64-select\\" id=\\"negsp_amt_" + row.slotKey + "\\" style=\\"width:100%;font-size:11.5px;padding:3px 6px;background:#fffbeb;border-color:#d97706;\\" onchange=\\"onSlotEdit64(\'" + row.slotKey + "\')\\">" + amtOpts + "</select>" +',
    '    "</div>" +',
    '  "</div>";',
    '}',
    '',
    'function buildDecisionOptionsAndSubBoxesHtml64(row) {',
    '  const curDec = String(row.curDecision || "").trim();',
    '  const selVal = normalizeBasePresetDecision64(curDec);',
    '  const planDetails = parsePlanDetailsByNumClient64(row.col2Plans);',
    '  const multiDocMap = parseMultiDoctorPlansFromCol2_64(row.col2Plans);',
    '',
    '  const showBackupOpt = canShowBackupOptionForRow64(row);',
    '  const availBackups = getAvailableBackupDoctorsForRow64(row);',
    '  const dayObj = state.backupDocsByDate[row.sortDate] || {};',
    '  const band = getSlotBand64(row.timeAndWage);',
    '  const displayBkList = availBackups.length > 0 ? availBackups : (dayObj[band] || []);',
    '  const backupNamesHint = displayBkList.length > 0 ? "（" + displayBkList.map(function(d) { return d.name + "先生"; }).join("・") + "）" : "";',
    '',
    '  const confMap = {',
    '    "1": evaluatePlanOptionConflict64(row, "1", planDetails, multiDocMap),',
    '    "2": evaluatePlanOptionConflict64(row, "2", planDetails, multiDocMap),',
    '    "3": evaluatePlanOptionConflict64(row, "3", planDetails, multiDocMap)',
    '  };',
    '',
    '  const hasAnyRawBlockInRow = ["1", "2", "3"].some(function(n) { return confMap[n] && confMap[n].hasRawBlock; });',
    '',
    '  const decOpts = DECISION_PRESETS.filter(function(opt) {',
    '    if (opt === "バックアップ医師に勤務依頼") return showBackupOpt;',
    '    if (opt === "案2" && !planDetails["2"]) return false;',
    '    if (opt === "案3" && !planDetails["3"]) return false;',
    '    if (opt === "案1, 案2" && (!planDetails["1"] || !planDetails["2"])) return false;',
    '    if (opt === "案1, 案3" && (!planDetails["1"] || !planDetails["3"])) return false;',
    '    if (opt === "案2, 案3" && (!planDetails["2"] || !planDetails["3"])) return false;',
    '    return true;',
    '  }).map(function(opt) {',
    '    let label = (opt === "") ? "(未選択・クリア)" : opt;',
    '    let isDisabled = false;',
    '',
    '    if (opt === "バックアップ医師に勤務依頼") {',
    '      label = "🚑 バックアップ医師に勤務依頼" + backupNamesHint;',
    '    } else if (/^案[123]$/.test(opt)) {',
    '      const pNum = opt.replace("案", "");',
    '      const c = confMap[pNum];',
    '      if (c) {',
    '        label += c.labelSuffix;',
    '        if (c.status === "BLOCK" && selVal !== opt) isDisabled = true;',
    '      }',
    '    } else if (opt.includes("案") && opt !== "全案") {',
    '      const nums = opt.match(/[123]/g) || [];',
    '      const hasBlock = nums.some(function(n) { return confMap[n] && confMap[n].status === "BLOCK"; });',
    '      const hasWarn = nums.some(function(n) { return confMap[n] && confMap[n].status === "WARN"; });',
    '      if (hasBlock) {',
    '        label += " 🔒(他枠で選択済の医師を含むため不可)";',
    '        if (selVal !== opt) isDisabled = true;',
    '      } else if (hasWarn) {',
    '        label += state.unlockedConflicts[row.slotKey] ? " 🔓(AまたはB選択的交渉)" : " ⚠️(他枠選択中の医師あり)";',
    '      }',
    '    } else if (opt === "全案") {',
    '      const existingNums = ["1", "2", "3"].filter(function(n) { return Boolean(planDetails[n]); });',
    '      const hasBlock = existingNums.some(function(n) { return confMap[n] && confMap[n].status === "BLOCK"; });',
    '      if (hasBlock) {',
    '        label += " 🔒(他枠で選択済の医師を含むため不可)";',
    '        if (selVal !== opt) isDisabled = true;',
    '      }',
    '    }',
    '',
    '    return "<option value=\\"" + opt + "\\"" + (opt === selVal ? " selected" : "") + (isDisabled ? " disabled" : "") + ">" + label + "</option>";',
    '  }).join("");',
    '',
    '  // ③列側にもロック解除ボタンを表示（プルダウンのすぐ下でワンクリック解除可能）',
    '  let conflictUnlockBarHtml = "";',
    '  if (hasAnyRawBlockInRow) {',
    '    if (state.unlockedConflicts[row.slotKey]) {',
    '      conflictUnlockBarHtml = "<div style=\\"margin-top:4px;padding:4px 6px;background:#f3e8ff;border:1.5px solid #9333ea;border-radius:5px;display:flex;align-items:center;justify-content:space-between;\\">" +',
    '        "<span style=\\"font-size:10.5px;font-weight:900;color:#6b21a8;\\">🔓 競合ロック解除中(AまたはB交渉)</span>" +',
    '        "<button type=\\"button\\" class=\\"btn-64\\" style=\\"background:#64748b;font-size:10px;padding:2px 6px;\\" onclick=\\"toggleConflictUnlock64(\'" + row.slotKey + "\')\\">🔒 戻す</button>" +',
    '      "</div>";',
    '    } else {',
    '      conflictUnlockBarHtml = "<button type=\\"button\\" class=\\"btn-64\\" style=\\"width:100%;margin-top:4px;background:#7c3aed;font-size:11px;padding:4px 6px;\\" onclick=\\"toggleConflictUnlock64(\'" + row.slotKey + "\')\\">🔓 ロック解除して「AまたはB」で交渉</button>";',
    '    }',
    '  }',
    '',
    '  let activePlanNums = [];',
    '  if (selVal === "全案") activePlanNums = ["1", "2", "3"];',
