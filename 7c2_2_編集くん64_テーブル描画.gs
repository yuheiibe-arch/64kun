    '  let decSelClass = "sel-unselected";',
    '  if (isStay) decSelClass = "sel-stay";',
    '  else if (hasDec) decSelClass = "sel-confirmed";',
    '  else if (hasSubDocMissing || (hasStaff && !hasDec)) decSelClass = "sel-missing-warn";',
    '',
    '  let stfSelClass = "sel-unselected";',
    '  if (isStay) stfSelClass = "sel-stay";',
    '  else if (hasStaff) stfSelClass = "sel-confirmed";',
    '  else if (Boolean(dec && dec !== "要検討") && !hasStaff) stfSelClass = "sel-missing-warn";',
    '',
    '  let rowClass = "slot-row";',
    '  let rowInlineBg = "background:#ffffff;";',
    '  if (isStay) {',
    '    rowClass += " is-stay";',
    '    rowInlineBg = "background:#e2e8f0;outline:2px solid #64748b;";',
    '  } else if (isDecided) {',
    '    rowClass += " is-decided";',
    '    rowInlineBg = "background:#dbeafe;outline:3px solid #0284c7;";',
    '  } else if (isIncomplete) {',
    '    rowClass += " is-incomplete";',
    '    rowInlineBg = "background:#fef08a;outline:3px solid #d97706;";',
    '  }',
    '',
    '  let afterClass = "diff-after";',
    '  let afterInlineStyle = "";',
