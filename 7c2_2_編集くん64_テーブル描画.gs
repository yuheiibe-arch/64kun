    '  let stfText = "⚠️(未定)";',
    '  if (vs.isStay) stfText = "ー(不要)";',
    '  else if (row.curAssignee === "担当者未定") stfText = "担当者未定(mnys:未定)";',
    '  else if (vs.hasStaff) stfText = row.curAssignee;',
