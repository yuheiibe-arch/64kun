    '    afterClass += " decided";',
    '    afterInlineStyle = "background:#bae6fd;color:#0c4a6e;border:1.5px solid #0284c7;padding:4px 6px;border-radius:4px;";',
    '  } else if (isIncomplete) {',
    '    afterClass += " incomplete";',
