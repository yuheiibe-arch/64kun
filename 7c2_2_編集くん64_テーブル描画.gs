    '      const col = dObj.isEitherOr ? "#92400e" : "#581c87";',
    '      const bdr = dObj.isEitherOr ? "#f59e0b" : "#a855f7";',
    '      mainTxt += "<br><span style=\\"display:inline-block;font-size:10.5px;font-weight:bold;color:" + col + ";background:" + bg + ";border:1.5px solid " + bdr + ";padding:2px 6px;border-radius:4px;margin-top:3px;\\">" + dObj.label + "</span>";',
