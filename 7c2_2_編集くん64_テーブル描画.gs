    '  return {',
    '    hasDec: hasDec,',
    '    hasSubDocMissing: hasSubDocMissing,',
    '    hasStaff: hasStaff,',
    '    isStay: isStay,',
    '    isDecided: isDecided,',
    '    isIncomplete: isIncomplete,',
