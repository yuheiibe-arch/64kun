function getHenshukun64ScriptPart2_() {
  return getHenshukun64ScriptPart2a_() + '\n' + getHenshukun64ScriptPart2b_();
}

function getHenshukun64ScriptPart2b_() {
  return [
    'function getRowVisualState64(row) {',
    '  const dec = stripNegotiationSpWageTag64(row.curDecision);',
    '  const stf = String(row.curAssignee || "").trim();',
    '  const hasSubDocMissing = dec.includes("医師未選択");',
