    '    const lbl2 = "② " + pair.doc2 + "先生 に依頼" + (c2.status === "BLOCK" ? " 🔒(他枠選択済・不可)" : (c2.status === "WARN" ? " ⚠️(他枠選択中)" : ""));',
    '    const lblBoth = "①・② 両方の先生に打診" + ((c1.status === "BLOCK" || c2.status === "BLOCK") ? " 🔒(片方が他枠選択済のため不可)" : "");',
    '',
    '    const subSelClass = pickedDocVal ? "sel-confirmed" : "sel-missing-warn";',
    '    return "<div id=\\"mdocbox_" + row.slotKey + "_" + pNum + "\\" style=\\"display:" + (isPlanSelected ? "block" : "none") + ";margin-top:5px;padding:5px 6px;background:#eff6ff;border:2px solid #0284c7;border-radius:6px;\\">" +',
    '      "<div style=\\"font-size:11px;font-weight:bold;color:#0369a1;margin-bottom:3px;\\">👨‍⚕️ 案" + pNum + "の打診医師を選択:</div>" +',
    '      "<select class=\\"n64-select " + subSelClass + "\\" style=\\"width:100%;font-size:11.5px;padding:4px 6px;\\" id=\\"mdoc_" + row.slotKey + "_" + pNum + "\\" onchange=\\"onSlotEdit64(\'" + row.slotKey + "\')\\">" +',
    '        "<option value=\\"\\"" + (!pickedDocVal ? " selected" : "") + ">⚠️ どちらの医師に頼むか選択</option>" +',
    '        "<option value=\\"" + opt1Val + "\\"" + (pickedDocVal === opt1Val ? " selected" : "") + (dis1 ? " disabled" : "") + ">" + lbl1 + "</option>" +',
    '        "<option value=\\"" + opt2Val + "\\"" + (pickedDocVal === opt2Val ? " selected" : "") + (dis2 ? " disabled" : "") + ">" + lbl2 + "</option>" +',
    '        "<option value=\\"" + optBothVal + "\\"" + (pickedDocVal === optBothVal ? " selected" : "") + (disBoth ? " disabled" : "") + ">" + lblBoth + "</option>" +',
    '      "</select>" +',
    '    "</div>";',
