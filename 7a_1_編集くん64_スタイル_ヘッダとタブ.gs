/**
 * ============================================================================
 * 7a_1_編集くん64_スタイル_ヘッダとタブ.gs（7a系 3分割の1）
 * ・HTML全体組立て（buildHenshukun64Html_ / getHenshukun64Style_）
 * ・共通変数・トップヘッダー・コントロールデッキ・地域チップ・日付タブバーのCSS
 * ============================================================================
 */

function buildHenshukun64Html_() {
  return [
    '<!DOCTYPE html><html><head><base target="_top">',
    getHenshukun64Style_(),
    '</head><body>',
    getHenshukun64BodyLayout_(),
    '<script>',
    getHenshukun64ScriptPart1_(),
    getHenshukun64ScriptPart2_(),
    getHenshukun64ScriptPart3_(),
    '</script>',
    '</body></html>'
  ].join('\n');
}

function getHenshukun64Style_() {
  return [
    '<style>',
    getHenshukun64StylePart1_(),
    getHenshukun64StylePart2_(),
    getHenshukun64StylePart3_(),
    '</style>'
  ].join('\n');
}

function getHenshukun64StylePart1_() {
  return [
    '  :root {',
    '    --n64-blue: #0046ad;',
    '    --n64-red: #e4002b;',
    '    --n64-yellow: #ffc72c;',
    '    --n64-green: #009b4d;',
    '    --n64-dark: #181c26;',
    '    --n64-panel: #252b3b;',
    '  }',
    '  * { box-sizing: border-box; }',
    '  body {',
    '    font-family: "BIZ UDPGothic", "Meiryo", "Hiragino Kaku Gothic ProN", sans-serif;',
    '    margin: 0; padding: 0;',
    '    background: var(--n64-dark);',
    '    color: #fff;',
    '    height: 100vh;',
    '    display: flex;',
    '    flex-direction: column;',
    '    overflow: hidden;',
    '    user-select: text;',
    '    -webkit-user-select: text;',
    '  }',
    '',
    '  .n64-header {',
    '    background: linear-gradient(90deg, #003380 0%, #1a2238 60%, #004d26 100%);',
    '    border-bottom: 3px solid var(--n64-yellow);',
    '    padding: 6px 12px;',
    '    display: flex;',
    '    justify-content: space-between;',
    '    align-items: center;',
    '    gap: 8px;',
    '    box-shadow: 0 3px 0 #000;',
    '    flex-shrink: 0;',
    '  }',
    '  .logo-box { display: flex; align-items: center; gap: 10px; min-width: 0; }',
    '  .n64-badge {',
    '    background: var(--n64-red);',
    '    color: var(--n64-yellow);',
    '    font-weight: 900;',
    '    font-size: 16px;',
    '    padding: 4px 10px;',
    '    border-radius: 7px;',
    '    border: 2px solid #fff;',
    '    box-shadow: 2px 2px 0 #000;',
    '    white-space: nowrap;',
    '    user-select: none;',
    '  }',
    '  .doc-link { color: #84ffff; font-size: 12px; font-weight: bold; text-decoration: underline; }',
    '  .player-box {',
    '    display: flex; align-items: center; gap: 8px;',
    '    background: rgba(0,0,0,0.55);',
    '    padding: 4px 10px;',
    '    border-radius: 7px;',
    '    border: 2px solid #7986cb;',
    '    white-space: nowrap;',
    '    flex-shrink: 0;',
    '  }',
    '  .active-players { font-size: 11.5px; color: var(--n64-yellow); font-weight: bold; white-space: nowrap; }',
    '',
    '  .control-deck {',
    '    background: var(--n64-panel);',
    '    padding: 6px 12px;',
    '    border-bottom: 2px solid #111;',
    '    display: flex;',
    '    flex-direction: column;',
    '    gap: 5px;',
    '    flex-shrink: 0;',
    '  }',
    '  .deck-row {',
    '    display: flex;',
    '    flex-wrap: nowrap;',
    '    gap: 6px;',
    '    align-items: center;',
    '    justify-content: space-between;',
    '  }',
    '  .mode-group { display: flex; align-items: center; gap: 5px; white-space: nowrap; }',
    '  .deck-label { font-size: 11.5px; font-weight: bold; white-space: nowrap; }',
    '',
    '  .progress-board {',
    '    display: flex;',
    '    align-items: center;',
    '    gap: 6px;',
    '    background: #11151f;',
    '    border: 2px solid var(--n64-yellow);',
    '    padding: 3px 8px;',
    '    border-radius: 6px;',
    '    white-space: nowrap;',
    '    flex-shrink: 0;',
    '  }',
    '  .prog-main { font-size: 12px; font-weight: 900; color: #fff; }',
    '  .prog-main span { color: var(--n64-yellow); font-size: 14px; }',
    '  .prog-remain {',
    '    background: var(--n64-red);',
    '    color: #fff;',
    '    font-size: 11px;',
    '    font-weight: bold;',
    '    padding: 2px 6px;',
    '    border-radius: 4px;',
    '  }',
    '  .prog-remain.all-done { background: var(--n64-green); }',
    '',
    '  .btn-64 {',
    '    cursor: pointer;',
    '    font-weight: bold;',
    '    font-size: 11.5px;',
    '    padding: 4px 8px;',
    '    border-radius: 6px;',
    '    border: 1.5px solid #fff;',
    '    box-shadow: 1px 2px 0 #000;',
    '    color: #fff;',
    '    background: #455a64;',
    '    white-space: nowrap;',
    '    user-select: none;',
    '  }',
    '  .btn-64:active { transform: translateY(1px); box-shadow: 0 1px 0 #000; }',
    '  .btn-64.active-mode { background: var(--n64-yellow); color: #000; border-color: #fff; }',
    '  .btn-blue { background: var(--n64-blue); }',
    '  .btn-green { background: var(--n64-green); }',
    '  .btn-red { background: var(--n64-red); }',
    '  .btn-yellow { background: var(--n64-yellow); color: #000; }',
    '',
    '  .region-chips { display: flex; gap: 4px; flex-wrap: nowrap; align-items: center; }',
    '  .chip {',
    '    cursor: pointer;',
    '    font-size: 11.5px;',
    '    font-weight: bold;',
    '    padding: 3px 9px;',
    '    border-radius: 14px;',
    '    border: 1.5px solid #90a4ae;',
    '    background: #141824;',
    '    color: #eceff1;',
    '    white-space: nowrap;',
    '    user-select: none;',
    '  }',
    '  .chip.selected {',
    '    background: #00e5ff;',
    '    color: #000;',
    '    border-color: #fff;',
    '    box-shadow: 0 0 6px rgba(0, 229, 255, 0.8);',
    '  }',
    '',
    '  .date-tabs-bar {',
    '    background: #11151f;',
    '    padding: 6px 12px 0;',
    '    display: flex;',
    '    flex-wrap: nowrap;',
    '    gap: 6px;',
    '    overflow-x: auto;',
    '    border-bottom: 3px solid var(--n64-yellow);',
    '    flex-shrink: 0;',
    '  }',
    '  .date-tabs-bar::-webkit-scrollbar { height: 5px; }',
    '  .date-tabs-bar::-webkit-scrollbar-track { background: #11151f; }',
    '  .date-tabs-bar::-webkit-scrollbar-thumb { background: #455a64; border-radius: 3px; }',
    '  .date-tabs-bar::-webkit-scrollbar-thumb:hover { background: var(--n64-yellow); }',
    '  .date-tab {',
    '    cursor: pointer;',
    '    padding: 6px 12px;',
    '    background: #2c354d;',
    '    color: #cfd8dc;',
    '    font-weight: bold;',
    '    font-size: 12.5px;',
    '    border-radius: 8px 8px 0 0;',
    '    border: 2px solid #546e7a;',
    '    border-bottom: none;',
    '    white-space: nowrap;',
    '    display: flex;',
    '    align-items: center;',
    '    gap: 6px;',
    '    user-select: none;',
    '    flex-shrink: 0;',
    '  }',
    '  .date-tab.active { background: var(--n64-yellow); color: #000; border-color: #fff; }',
    '  .tab-count {',
    '    background: rgba(0,0,0,0.35);',
    '    color: #fff;',
    '    padding: 1px 6px;',
    '    border-radius: 10px;',
    '    font-size: 11px;',
    '  }',
    '  .tab-count.has-remain { background: #dc2626; color: #fff; }',
    '  .tab-count.tab-done { background: #15803d; color: #fff; }'
  ].join('\n');
}