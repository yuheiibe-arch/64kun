/**
 * ============================================================================
 * 7c2_編集くん64_テーブル描画.gs
 * （3時間帯別のバックアップ医師表示・午後/夜間の他拠点排他対応・カスタムコメント対応版）
 * ============================================================================
 */

function getHenshukun64ScriptPart2_() {
  return [
    'function formatPlansHtml64(col2Text) {',
    '  const rawLines = String(col2Text || "").split("\\n");',
    '  const planHtmls = [];',
    '  const noteLines = [];',
    '',
    '  rawLines.forEach(function(line) {',
    '    const s = line.trim();',
    '    if (!s) return;',
    '    if (s.startsWith("💡") || s.startsWith("・") || s.startsWith("📝")) {',
    '      noteLines.push(s);',
    '    } else {',
    '      const m = s.match(/^(【案[123]】)(.*)$/);',
    '      if (m) planHtmls.push("<div class=\\"plan-line\\"><b>" + m[1] + "</b>" + m[2] + "</div>");',
    '      else planHtmls.push("<div class=\\"plan-line\\">" + s + "</div>");',
    '    }',
    '  });',
    '',
    '  if (noteLines.length > 0) {',
    '    planHtmls.push("<div class=\\"note-line\\">" + noteLines.join("\\n") + "</div>");',
    '  }',
    '  return planHtmls.join("");',
    '}',
    '',
    'function buildAfterDiffHtml64(row) {',
    '  const decText = row.curDecision || "未選択";',
    '  const isStay = isStayLikeDecision64(row.curDecision);',
    '  let stfText = "未定";',
    '  if (isStay) stfText = "ー(不要)";',
    '  else if (row.curAssignee === "担当者未定") stfText = "担当者未定(mnys:未定)";',
    '  else if (row.curAssignee) stfText = row.curAssignee;',
    '',
    '  let mainTxt = "【編集後】" + decText + " ／ 担当:" + stfText;',
    '  if (Array.isArray(row.customDocs) && row.customDocs.length > 0) {',
    '    const idList = row.customDocs.map(function(d) { return d.name + (d.licenseNo ? ":" + d.licenseNo : ""); }).join(", ");',
    '    mainTxt += "<br><span class=\\"diff-lic-sub\\">🆔 医籍番号: " + idList + "</span>";',
    '  }',
    '  if (row.customComment) {',
    '    mainTxt += "<br><span style=\\"display:inline-block;font-size:11px;color:#1e40af;background:#dbeafe;padding:1px 5px;border-radius:4px;margin-top:2px;\\">💬 メモ: " + row.customComment + "</span>";',
    '  }',
    '  return mainTxt;',
    '}',
    '',
    'function buildPickedDocsTagsHtml64(slotKey, customDocs) {',
    '  if (!Array.isArray(customDocs) || customDocs.length === 0) return "";',
    '  return customDocs.map(function(d, idx) {',
    '    const licLabel = d.licenseNo ? " (医籍:" + d.licenseNo + ")" : " (番号未登録)";',
    '    return "<span class=\\"picked-doc-tag\\">" +',
    '      "🆔 " + d.name + licLabel +',
    '      "<span class=\\"del-btn\\" title=\\"削除\\" onclick=\\"removeCustomDoc64(\'" + slotKey + "\'," + idx + ")\\">×</span>" +',
    '    "</span>";',
    '  }).join("");',
    '}',
    '',
    'function renderStageTable() {',
    '  const lockedByOthers = getLockedStaffSetByOthers();',
    '  const rows = state.slotRows.filter(function(r) {',
    '    return r.dateLabel === state.activeDateTab && isRowMatchRegionFilter(r);',
    '  });',
    '',
    '  if (rows.length === 0) {',
    '    document.getElementById("stageTableBody").innerHTML =',
    '      "<tr><td colspan=\\"5\\" style=\\"text-align:center;padding:24px;font-weight:bold;\\">該当する不在枠はありません（エリアまたは日付を切り替えてください）</td></tr>";',
    '    return;',
    '  }',
    '',
    '  const actTypeOpts = CUSTOM_ACTION_TYPES.map(function(t) { return "<option value=\\"" + t + "\\">📌 種別: " + t + "</option>"; }).join("");',
    '',
    '  const html = rows.map(function(row) {',
    '    const curDec = String(row.curDecision || "").trim();',
    '    const curCmnt = String(row.customComment || "").trim();',
    '    const isEdited = (curDec !== row.origDecision) || (row.curAssignee !== row.origAssignee) || (curCmnt !== (row.origComment || ""));',
    '    const isSpecialStay = isSpecialStayDecision64(curDec);',
    '    const isStay = isStayLikeDecision64(curDec);',
    '    const isBackupDec = isBackupDecision64(curDec);',
    '    const isEmptyOrExamine = (!curDec || curDec === "要検討");',
    '    const isPreset = isEmptyOrExamine || DECISION_PRESETS.includes(curDec) || isSpecialStay || isBackupDec;',
    '',
    '    let selVal = "カスタム入力";',
    '    if (isEmptyOrExamine) selVal = "";',
    '    else if (isSpecialStay) selVal = "特別時給＋ステイ";',
    '    else if (isBackupDec) selVal = "バックアップ医師に勤務依頼";',
    '    else if (DECISION_PRESETS.includes(curDec)) selVal = curDec;',
    '',
    '    const customVal = isPreset ? "" : curDec;',
    '    const curSpAmt = extractSpecialStayAmount64(curDec);',
    '    const showBackupOpt = canShowBackupOptionForRow64(row);',
    '    const availBackups = getAvailableBackupDoctorsForRow64(row);',
    '    const dayObj = state.backupDocsByDate[row.sortDate] || {};',
    '    const band = getSlotBand64(row.timeAndWage);',
    '    const displayBkList = availBackups.length > 0 ? availBackups : (dayObj[band] || []);',
    '    const backupNamesHint = displayBkList.length > 0 ? "（" + displayBkList.map(function(d) { return d.name + "先生"; }).join("・") + "）" : "";',
    '',
    '    const decOpts = DECISION_PRESETS.filter(function(opt) {',
    '      if (opt === "バックアップ医師に勤務依頼") return showBackupOpt;',
    '      return true;',
    '    }).map(function(opt) {',
    '      let label = (opt === "") ? "(未選択・クリア)" : opt;',
    '      if (opt === "バックアップ医師に勤務依頼") label = "🚑 バックアップ医師に勤務依頼" + backupNamesHint;',
    '      return "<option value=\\"" + opt + "\\"" + (opt === selVal ? " selected" : "") + ">" + label + "</option>";',
    '    }).join("");',
    '',
    '    const spAmtOpts = SPECIAL_STAY_AMOUNTS.map(function(amt) {',
    '      const label = (amt === "+2,000円") ? amt + " (標準)" : amt;',
    '      return "<option value=\\"" + amt + "\\"" + (amt === curSpAmt ? " selected" : "") + ">💰 特別時給 " + label + "</option>";',
    '    }).join("");',
    '',
    '    const curAsg = String(row.curAssignee || "").trim();',
    '    const isEmptyStaff = (isStay || !curAsg || curAsg === "(未定)" || curAsg === "未定");',
    '    const isTantoshaMitei = (!isStay && curAsg === "担当者未定");',
    '    const emptyStaffLabel = isStay ? "(担当不要)" : "(未定)";',
    '',
    '    const staffOpts = [',
    '      "<option value=\\"\\"" + (isEmptyStaff ? " selected" : "") + ">" + emptyStaffLabel + "</option>",',
    '      "<option value=\\"担当者未定\\"" + (isTantoshaMitei ? " selected" : "") + ">担当者未定</option>"',
    '    ].concat(state.staffList.map(function(s) {',
    '      const locked = lockedByOthers.has(s) && s !== curAsg;',
    '      const label = locked ? "🔒" + s + "(他作業中)" : s;',
    '      const selAttr = (!isStay && s === curAsg) ? " selected" : "";',
    '      return "<option value=\\"" + s + "\\"" + selAttr + (locked ? " disabled" : "") + ">" + label + "</option>";',
    '    })).join("");',
    '',
    '    const stfStyle = isStay',
    '      ? "width:100%;background:#cbd5e1;color:#64748b;cursor:not-allowed;opacity:0.65;"',
    '      : "width:100%;";',
    '',
    '    const origDecLabel = row.origDecision || "未選択";',
    '',
    '    return "<tr class=\\"slot-row" + (isEdited ? " is-edited" : "") + (isStay ? " is-stay" : "") + "\\" id=\\"tr_" + row.slotKey + "\\">" +',
    '      "<td>" +',
    '        "<div style=\\"font-size:11.5px;font-weight:bold;color:#475569;margin-bottom:4px;\\">" + row.dateLabel + "</div>" +',
    '        "<div><span class=\\"region-tag" + (row.macroArea === "関西" ? " kansai" : "") + "\\">" + row.clinicGroup + "</span>" +',
    '        "<span class=\\"clinic-name\\">" + row.clinicTitle + "</span></div>" +',
    '        "<div class=\\"time-wage\\">" + row.timeAndWage + "</div>" +',
    '      "</td>" +',
    '      "<td>" + formatPlansHtml64(row.col2Plans) + "</td>" +',
    '      "<td>" +',
    '        "<div class=\\"diff-box\\">" +',
    '          "<div class=\\"diff-before\\">【編集前】" + origDecLabel + " ／ 担当:" + (row.origAssignee || "未定") + "</div>" +',
    '          "<div class=\\"diff-after" + (isEdited ? " changed" : "") + "\\" id=\\"after_" + row.slotKey + "\\">" +',
    '            buildAfterDiffHtml64(row) +',
    '          "</div>" +',
    '        "</div>" +',
    '      "</td>" +',
    '      "<td>" +',
    '        "<select class=\\"n64-select\\" style=\\"width:100%;\\" id=\\"sel_" + row.slotKey + "\\" onchange=\\"onSlotEdit64(\'" + row.slotKey + "\')\\">" + decOpts + "</select>" +',
    '        "<div id=\\"spbox_" + row.slotKey + "\\" style=\\"display:" + (selVal === "特別時給＋ステイ" ? "block" : "none") + ";margin-top:6px;padding:6px;background:#fef3c7;border:2px solid #f59e0b;border-radius:6px;\\">" +',
    '          "<div style=\\"font-size:11px;font-weight:bold;color:#b45309;margin-bottom:3px;\\">⚡ 時給アップ幅を選択（上限+5,000円）:</div>" +',
    '          "<select class=\\"n64-select\\" style=\\"width:100%;background:#fffbeb;\\" id=\\"spamt_" + row.slotKey + "\\" onchange=\\"onSlotEdit64(\'" + row.slotKey + "\')\\">" + spAmtOpts + "</select>" +',
    '        "</div>" +',
    '        "<div class=\\"custom-builder\\" id=\\"cbox_" + row.slotKey + "\\" style=\\"display:" + (selVal === "カスタム入力" ? "block" : "none") + ";\\">" +',
    '          "<select class=\\"n64-select\\" id=\\"act_" + row.slotKey + "\\" style=\\"width:100%;padding:4px 6px;font-size:11.5px;margin-bottom:4px;background:#fefce8;\\" onchange=\\"onCustomActionTypeChange64(\'" + row.slotKey + "\')\\">" + actTypeOpts + "</select>" +',
    '          "<div style=\\"position:relative;margin-bottom:4px;\\">" +',
    '            "<input type=\\"text\\" class=\\"n64-input\\" id=\\"srch_" + row.slotKey + "\\" style=\\"width:100%;padding:4px 7px;font-size:12px;\\" " +',
    '              "placeholder=\\"🔍 医師名検索(例:須貝)\\" oninput=\\"onSearchDocInput64(\'" + row.slotKey + "\')\\" onfocus=\\"onSearchDocInput64(\'" + row.slotKey + "\')\\">" +',
    '            "<div class=\\"suggest-dropdown\\" style=\\"top:30px;left:0;right:0;\\" id=\\"sug_" + row.slotKey + "\\"></div>" +',
    '          "</div>" +',
    '          "<input type=\\"text\\" class=\\"n64-input\\" id=\\"cus_" + row.slotKey + "\\" style=\\"width:100%;font-size:12px;padding:4px 7px;margin-bottom:4px;\\" " +',
    '            "placeholder=\\"記載文(直接編集も可)\\" value=\\"" + customVal.replace(/"/g, "&quot;") + "\\" oninput=\\"onSlotEdit64(\'" + row.slotKey + "\')\\">" +',
    '          "<input type=\\"text\\" class=\\"n64-input\\" id=\\"cmnt_" + row.slotKey + "\\" style=\\"width:100%;font-size:11.5px;padding:4px 7px;background:#f0fdf4;border-color:#16a34a;\\" " +',
    '            "placeholder=\\"💬 コメント・メモ(アプローチ表＆mnysへ転記)\\" value=\\"" + curCmnt.replace(/"/g, "&quot;") + "\\" oninput=\\"onSlotEdit64(\'" + row.slotKey + "\')\\">" +',
    '          "<div class=\\"picked-tags-box\\" id=\\"tags_" + row.slotKey + "\\">" + buildPickedDocsTagsHtml64(row.slotKey, row.customDocs) + "</div>" +',
    '        "</div>" +',
    '      "</td>" +',
    '      "<td>" +',
    '        "<select class=\\"n64-select\\" style=\\"" + stfStyle + "\\" id=\\"stf_" + row.slotKey + "\\" onchange=\\"onSlotEdit64(\'" + row.slotKey + "\')\\"" + (isStay ? " disabled" : "") + ">" + staffOpts + "</select>" +',
    '        "<button id=\\"rst_" + row.slotKey + "\\" class=\\"btn-64\\" style=\\"display:" + (isEdited ? "block" : "none") + ";width:100%;margin-top:5px;padding:3px 6px;font-size:11px;background:#64748b;\\" onclick=\\"resetSlotRow64(\'" + row.slotKey + "\')\\">↩️ 編集前に戻す</button>" +',
    '      "</td>" +',
    '    "</tr>";',
    '  }).join("");',
    '',
    '  document.getElementById("stageTableBody").innerHTML = html;',
    '}',
    '',
    'function renderBundlesTable() {',
    '  const html = state.bundleRows.map(function(b) {',
    '    const isEdited = (b.curVal !== b.origVal);',
    '    return "<tr class=\\"slot-row" + (isEdited ? " is-edited" : "") + "\\">" +',
    '      "<td style=\\"font-weight:900;color:#0d47a1;\\">" + b.doctor + "</td>" +',
    '      "<td style=\\"white-space:pre-wrap;font-size:12px;\\">" + b.slots + "</td>" +',
    '      "<td style=\\"font-size:12px;\\">" + b.note + "</td>" +',
    '      "<td>" +',
    '        "<div class=\\"diff-box\\">" +',
    '          "<div class=\\"diff-before\\">【編集前】" + b.origVal + "</div>" +',
    '          "<div class=\\"diff-after" + (isEdited ? " changed" : "") + "\\" id=\\"bafter_" + b.bundleKey + "\\">【編集後】" + b.curVal + "</div>" +',
    '        "</div>" +',
    '      "</td>" +',
    '      "<td>" +',
    '        "<input type=\\"text\\" class=\\"n64-input\\" style=\\"width:100%;\\" value=\\"" + b.curVal.replace(/"/g, "&quot;") + "\\" " +',
    '          "placeholder=\\"例: 採用 佐藤 / ステイ\\" oninput=\\"onBundleEdit64(\'" + b.bundleKey + "\', this.value)\\">" +',
    '      "</td>" +',
    '    "</tr>";',
    '  }).join("");',
    '  document.getElementById("bundlesTableBody").innerHTML = html || "<tr><td colspan=\\"5\\">該当なし</td></tr>";',
    '}'
  ].join('\n');
}