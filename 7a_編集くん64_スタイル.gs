function buildHenshukun64Html_() {
  return [
    '<!DOCTYPE html><html><head><base target="_top">',
    getHenshukun64Style_(),
    '</head><body>',
    getHenshukun64BodyLayout_(),
    '<script>',
    getHenshukun64ScriptPart1_(),
    getHenshukun64ScriptPart2_(),
    getHenshukun64ScriptPart3_(),
    '</script>',
    '</body></html>'
  ].join('\n');
}

