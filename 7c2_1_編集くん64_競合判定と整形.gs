function getHenshukun64ScriptPart2a_() {
  return [
    'function autoFixDoctorTyposClient64(text) {',
    '  let s = String(text || "")',
    '    .replace(/（複数枠で確定時は自動でおまとめ打診化）/g, "")',
    '    .replace(/\\(複数枠で確定時は自動でおまとめ打診化\\)/g, "");',
    '  if (!s || !state.doctorSearchList || state.doctorSearchList.length === 0) return s;',
    '  const toKey = function(str) {',
    '    return String(str || "")',
    '      .replace(/[\\s\\u3000]+/g, "")',
    '      .replace(/[巧匠]/g, "匠").replace(/[滝瀧泷]/g, "瀧")',
    '      .replace(/[高髙]/g, "高").replace(/[崎﨑嵜]/g, "崎")',
    '      .replace(/[辺邊邉]/g, "辺").replace(/[斎齋齊斉]/g, "斎")',
    '      .replace(/[沢澤]/g, "沢").replace(/[広廣]/g, "広")',
    '      .replace(/[浜濵濱]/g, "浜").replace(/[真眞]/g, "真").replace(/[恵惠]/g, "恵");',
    '  };',
    '  return s.replace(/([一-龠々ヶケ]{2,6})先生/g, function(full, rawName) {',
    '    if (state.doctorSearchList.some(function(d) { return d.name === rawName; })) return full;',
    '    const k = toKey(rawName);',
    '    const hit = state.doctorSearchList.find(function(d) { return toKey(d.name) === k; });',
    '    return hit ? (hit.name + "先生") : full;',
    '  });',
    '}',
    '',
    'function parseTimeRangeMinutesClient64(timeStr) {',
    '  const m = String(timeStr || "").match(/(\\d{1,2}):(\\d{2})\\s*[\\-〜～~]\\s*(\\d{1,2}):(\\d{2})/);',
    '  if (!m) return { startMin: 540, endMin: 780, timeLabel: "09:00-13:00" };',
    '  const sh = Number(m[1]), sm = Number(m[2]), eh = Number(m[3]), em = Number(m[4]);',
    '  return {',
    '    startMin: sh * 60 + sm,',
    '    endMin: eh * 60 + em,',
    '    timeLabel: ("0" + sh).slice(-2) + ":" + ("0" + sm).slice(-2) + "-" + ("0" + eh).slice(-2) + ":" + ("0" + em).slice(-2)',
    '  };',
    '}',
    '',
    'function parsePlanDetailsByNumClient64(col2Text) {',
    '  const fixed = autoFixDoctorTyposClient64(col2Text);',
    '  const map = {};',
    '  String(fixed || "").split("\\n").forEach(function(line) {',
    '    const m = line.trim().match(/^【案([123])】(.*)$/);',
    '    if (!m) return;',
    '    const num = m[1];',
    '    const text = m[2].trim();',
    '    const isTwoDocMove = text.includes("2診目崩し") || text.includes("移動打診");',
    '    let fromClinic = "";',
    '    const fm = text.match(/】([^\\(（\\s]+?)[（\\(](?:※|[12]診)/);',
    '    if (fm) fromClinic = fm[1].trim();',
    '    const docs = [];',
    '    const re = /(?:①|②|③|前医の|後医の|2診目[：:]|1診[：:]|^|\\s)([一-龠々ヶケ]{2,6})先生/g;',
    '    let dm;',
    '    while ((dm = re.exec(text.replace(/※残る.*?に、/g, ""))) !== null) {',
    '      if (dm[1] && !docs.includes(dm[1])) docs.push(dm[1]);',
    '    }',
    '    map[num] = { num: num, text: text, isTwoDocMove: isTwoDocMove, fromClinic: fromClinic, docs: docs };',
    '  });',
    '  return map;',
    '}',
    '',
    'function getChosenDoctorsForRowClient64(row) {',
    '  const dec = stripNegotiationSpWageTag64(row.curDecision);',
    '  if (!dec || dec === "要検討" || dec.includes("医師未選択") || isStayLikeDecision64(dec)) return [];',
    '  const baseSel = normalizeBasePresetDecision64(dec);',
    '  if (baseSel === "カスタム入力" && Array.isArray(row.customDocs) && row.customDocs.length > 0) {',
    '    return row.customDocs.map(function(d) { return d.name; }).filter(Boolean);',
    '  }',
    '  const planDetails = parsePlanDetailsByNumClient64(row.col2Plans);',
    '  const multiDocMap = parseMultiDoctorPlansFromCol2_64(row.col2Plans);',
    '  let activePlanNums = [];',
    '  if (baseSel === "全案") activePlanNums = ["1", "2", "3"];',
    '  else if (baseSel.indexOf("案") !== -1) activePlanNums = baseSel.match(/[123]/g) || [];',
    '',
    '  const docs = [];',
    '  if (activePlanNums.length > 0) {',
    '    activePlanNums.forEach(function(pNum) {',
    '      if (multiDocMap[pNum]) {',
    '        const picked = extractPickedSubDocForPlan64(dec, pNum);',
    '        if (picked.includes(multiDocMap[pNum].doc1)) docs.push(multiDocMap[pNum].doc1);',
    '        else if (picked.includes(multiDocMap[pNum].doc2)) docs.push(multiDocMap[pNum].doc2);',
    '        else if (picked.includes("両方")) {',
    '          docs.push(multiDocMap[pNum].doc1);',
    '          docs.push(multiDocMap[pNum].doc2);',
    '        }',
    '        return;',
    '      }',
    '      const pInfo = planDetails[pNum];',
    '      if (pInfo && pInfo.docs) {',
    '        pInfo.docs.forEach(function(d) { if (!docs.includes(d)) docs.push(d); });',
    '      }',
    '    });',
    '  } else {',
    '    const re = /(?:①|②|③|前医の|後医の|2診目[：:]|1診[：:]|^|\\s)([一-龠々ヶケ]{2,6})先生/g;',
    '    let m;',
    '    while ((m = re.exec(dec)) !== null) {',
    '      if (m[1] && !docs.includes(m[1])) docs.push(m[1]);',
    '    }',
    '  }',
    '  return docs;',
    '}',
    '',
    'function evaluateDoctorConflictWithOtherChosenRows64(row, docName, isTwoDocMoveInThisRow, fromClinicInThisRow) {',
    '  const myTime = parseTimeRangeMinutesClient64(row.timeAndWage);',
    '  const isUnlockedByUser = Boolean(state.unlockedConflicts && state.unlockedConflicts[row.slotKey]);',
    '  let worstStatus = "OK";',
    '  let hasRawBlock = false;',
    '  const reasons = [];',
    '',
    '  state.slotRows.forEach(function(otherRow) {',
    '    if (otherRow.slotKey === row.slotKey || otherRow.sortDate !== row.sortDate) return;',
    '    const otherChosenDocs = getChosenDoctorsForRowClient64(otherRow);',
    '    if (!otherChosenDocs.includes(docName)) return;',
    '',
    '    const otherTime = parseTimeRangeMinutesClient64(otherRow.timeAndWage);',
    '    const otherClinic = otherRow.clinicNameClean;',
    '    const sameClinic = (otherClinic === row.clinicNameClean);',
    '',
    '    if (Math.max(myTime.startMin, otherTime.startMin) < Math.min(myTime.endMin, otherTime.endMin)) {',
    '      hasRawBlock = true;',
    '      if (isUnlockedByUser) {',
    '        if (worstStatus !== "BLOCK") worstStatus = "WARN";',
    '        reasons.push("🔓【ロック解除・選択的交渉】「" + otherClinic + "(" + otherTime.timeLabel + ")」または「" + row.clinicNameClean + "(" + myTime.timeLabel + ")」のどちらかで可能か打診");',
    '      } else {',
    '        worstStatus = "BLOCK";',
    '        reasons.push("⛔" + docName + "先生は同時間帯の【" + otherClinic + " " + otherTime.timeLabel + "】で選択済（同時勤務不可）");',
    '      }',
    '      return;',
    '    }',
    '',
    '    const gapMin = (myTime.endMin <= otherTime.startMin)',
    '      ? (otherTime.startMin - myTime.endMin)',
    '      : (myTime.startMin - otherTime.endMin);',
    '    if (!sameClinic && gapMin < 60) {',
    '      hasRawBlock = true;',
    '      if (isUnlockedByUser) {',
    '        if (worstStatus !== "BLOCK") worstStatus = "WARN";',
    '        reasons.push("🔓【ロック解除・選択的交渉】「" + otherClinic + "(" + otherTime.timeLabel + ")」または「" + row.clinicNameClean + "(" + myTime.timeLabel + ")」のどちらかで可能か打診");',
    '      } else {',
    '        worstStatus = "BLOCK";',
    '        reasons.push("⛔" + docName + "先生は【" + otherClinic + " " + otherTime.timeLabel + "】で選択済（移動時間" + gapMin + "分のため不可）");',
    '      }',
    '      return;',
    '    }',
    '',
    '    if (!sameClinic) {',
    '      const otherPlanDetails = parsePlanDetailsByNumClient64(otherRow.col2Plans);',
    '      const otherBaseSel = normalizeBasePresetDecision64(otherRow.curDecision);',
    '      let otherIsMovingFromMyClinic = false;',
    '      ["1", "2", "3"].forEach(function(pNum) {',
    '        if (otherBaseSel.includes(pNum) || otherBaseSel === "全案") {',
    '          const od = otherPlanDetails[pNum];',
    '          if (od && od.isTwoDocMove && od.docs.includes(docName) && od.fromClinic === row.clinicNameClean) {',
    '            otherIsMovingFromMyClinic = true;',
    '          }',
    '        }',
    '      });',
    '',
    '      if ((isTwoDocMoveInThisRow && fromClinicInThisRow === otherClinic) || otherIsMovingFromMyClinic) {',
    '        hasRawBlock = true;',
    '        if (isUnlockedByUser) {',
    '          if (worstStatus !== "BLOCK") worstStatus = "WARN";',
    '          reasons.push("🔓【ロック解除・選択的交渉】「" + otherClinic + "(" + otherTime.timeLabel + ")」または「" + row.clinicNameClean + "(" + myTime.timeLabel + ")」で打診");',
    '        } else {',
    '          worstStatus = "BLOCK";',
    '          reasons.push("⛔" + docName + "先生は【" + otherClinic + " " + otherTime.timeLabel + "】で選択済（元拠点から2診崩し移動させると往復破綻するため不可）");',
    '        }',
    '        return;',
    '      }',
    '',
    '      if (worstStatus !== "BLOCK") worstStatus = "WARN";',
    '      reasons.push("⚠️" + docName + "先生は同日の【" + otherClinic + " " + otherTime.timeLabel + "】でも選択中（移動距離要確認）");',
    '    } else {',
    '      if (worstStatus === "OK") worstStatus = "WARN";',
    '      reasons.push("🔗" + docName + "先生は同拠点の【" + otherClinic + " " + otherTime.timeLabel + "】でも選択中（おまとめ対象）");',
    '    }',
    '  });',
    '',
    '  return { status: worstStatus, hasRawBlock: hasRawBlock, isUnlockedByUser: isUnlockedByUser, reason: reasons.join(" ／ ") };',
    '}',
    '',
    'function evaluatePlanOptionConflict64(row, planNum, planDetails, multiDocMap) {',
    '  const pInfo = planDetails[planNum];',
    '  if (!pInfo || !pInfo.docs || pInfo.docs.length === 0) return { status: "OK", hasRawBlock: false, labelSuffix: "", reason: "" };',
    '',
    '  if (multiDocMap[planNum]) {',
    '    const d1 = multiDocMap[planNum].doc1;',
    '    const d2 = multiDocMap[planNum].doc2;',
    '    const c1 = evaluateDoctorConflictWithOtherChosenRows64(row, d1, pInfo.isTwoDocMove, pInfo.fromClinic);',
    '    const c2 = evaluateDoctorConflictWithOtherChosenRows64(row, d2, pInfo.isTwoDocMove, pInfo.fromClinic);',
    '    const anyRawBlock = c1.hasRawBlock || c2.hasRawBlock;',
    '    if (c1.status === "BLOCK" && c2.status === "BLOCK") {',
    '      return {',
    '        status: "BLOCK",',
    '        hasRawBlock: anyRawBlock,',
    '        labelSuffix: " 🔒(①" + d1 + "・②" + d2 + "とも他枠選択済で不可)",',
    '        reason: c1.reason + " ／ " + c2.reason',
    '      };',
    '    }',
    '    if (c1.status === "BLOCK") {',
    '      return {',
    '        status: "WARN",',
    '        hasRawBlock: anyRawBlock,',
    '        labelSuffix: " (※①" + d1 + "は他枠選択済 ➔ 🟢②" + d2 + "のみ可)",',
    '        reason: c1.reason + " ➔ 🟢【② " + d2 + "先生】のみ選択可能です"',
    '      };',
    '    }',
    '    if (c2.status === "BLOCK") {',
    '      return {',
    '        status: "WARN",',
    '        hasRawBlock: anyRawBlock,',
    '        labelSuffix: " (※②" + d2 + "は他枠選択済 ➔ 🟢①" + d1 + "のみ可)",',
    '        reason: c2.reason + " ➔ 🟢【① " + d1 + "先生】のみ選択可能です"',
    '      };',
    '    }',
    '    if (c1.status === "WARN" || c2.status === "WARN") {',
    '      return {',
    '        status: "WARN",',
    '        hasRawBlock: anyRawBlock,',
    '        labelSuffix: (c1.isUnlockedByUser || c2.isUnlockedByUser) ? " 🔓(ロック解除: AまたはBで選択的交渉)" : " ⚠️(他枠選択中の医師あり・移動確認)",',
    '        reason: [c1.reason, c2.reason].filter(Boolean).join(" ／ ")',
    '      };',
    '    }',
    '    return { status: "OK", hasRawBlock: false, labelSuffix: "", reason: "" };',
    '  }',
    '',
    '  const docName = pInfo.docs[0];',
    '  const conf = evaluateDoctorConflictWithOtherChosenRows64(row, docName, pInfo.isTwoDocMove, pInfo.fromClinic);',
    '  if (conf.status === "BLOCK") {',
    '    return { status: "BLOCK", hasRawBlock: conf.hasRawBlock, labelSuffix: " 🔒(" + docName + "先生: 他枠選択済・不可)", reason: conf.reason };',
    '  }',
    '  if (conf.status === "WARN") {',
    '    return {',
    '      status: "WARN",',
    '      hasRawBlock: conf.hasRawBlock,',
    '      labelSuffix: conf.isUnlockedByUser ? (" 🔓(" + docName + "先生: AまたはBで選択的交渉)") : (" ⚠️(" + docName + "先生: 他枠でも選択中)"),',
    '      reason: conf.reason',
    '    };',
    '  }',
    '  return { status: "OK", hasRawBlock: false, labelSuffix: "", reason: "" };',
    '}',
    '',
    'function getSameDayDuplicateChosenInfoClient64(row) {',
    '  const myDocs = getChosenDoctorsForRowClient64(row);',
    '  if (myDocs.length === 0) return [];',
    '  const myTime = parseTimeRangeMinutesClient64(row.timeAndWage);',
    '  const dupInfos = [];',
    '  myDocs.forEach(function(docName) {',
    '    const otherSlots = [];',
    '    let hasOverlapOrBlock = false;',
    '    state.slotRows.forEach(function(otherRow) {',
    '      if (otherRow.slotKey === row.slotKey || otherRow.sortDate !== row.sortDate) return;',
    '      const otherDocs = getChosenDoctorsForRowClient64(otherRow);',
    '      if (otherDocs.includes(docName)) {',
    '        const ot = parseTimeRangeMinutesClient64(otherRow.timeAndWage);',
    '        if (Math.max(myTime.startMin, ot.startMin) < Math.min(myTime.endMin, ot.endMin) ||',
    '            (otherRow.clinicNameClean !== row.clinicNameClean && Math.abs(myTime.startMin - ot.endMin) < 60 && Math.abs(ot.startMin - myTime.endMin) < 60)) {',
    '          hasOverlapOrBlock = true;',
    '        }',
    '        otherSlots.push(otherRow.clinicNameClean + "(" + ot.timeLabel + ")");',
    '      }',
    '    });',
    '    if (otherSlots.length > 0) {',
    '      dupInfos.push({',
    '        docName: docName,',
    '        isEitherOr: hasOverlapOrBlock,',
    '        label: hasOverlapOrBlock',
    '          ? ("🔀【AまたはB選択的交渉】" + docName + "先生：「" + otherSlots.join("」または「") + "」または「" + row.clinicNameClean + "(" + myTime.timeLabel + ")」が可能か打診")',
    '          : ("🔗【同日おまとめ打診】" + docName + "先生[他:" + otherSlots.join("・") + "]")',
    '      });',
    '    }',
    '  });',
    '  return dupInfos;',
    '}',
    '',
    'function formatPlansHtml64(col2Text, rowOpt) {',
    '  const fixedText = autoFixDoctorTyposClient64(col2Text);',
    '  const rawLines = String(fixedText || "").split("\\n");',
    '  const planHtmls = [];',
    '  const noteLines = [];',
    '  const planDetails = rowOpt ? parsePlanDetailsByNumClient64(col2Text) : {};',
    '  const multiDocMap = rowOpt ? parseMultiDoctorPlansFromCol2_64(col2Text) : {};',
    '',
    '  let highlightedPlanNums = [];',
    '  if (rowOpt) {',
    '    const baseSel = normalizeBasePresetDecision64(rowOpt.curDecision);',
    '    if (baseSel && baseSel !== "全案" && baseSel.indexOf("案") !== -1) {',
    '      highlightedPlanNums = baseSel.match(/[123]/g) || [];',
    '    }',
    '  }',
    '',
    '  rawLines.forEach(function(line) {',
    '    const s = line.trim();',
    '    if (!s) return;',
    '    if (s.startsWith("💡") || s.startsWith("・") || s.startsWith("📝")) {',
    '      noteLines.push(s);',
    '    } else {',
    '      const m = s.match(/^(【案([123])】)(.*)$/);',
    '      if (m && rowOpt) {',
    '        const pNum = m[2];',
    '        const isSelectedMarker = highlightedPlanNums.includes(pNum);',
    '        const markerStyle = isSelectedMarker',
    '          ? "background:#ffd6d6 !important;border:2px solid #e11d48 !important;border-left:7px solid #be123c !important;"',
    '          : "";',
    '        const markerBadge = isSelectedMarker',
    '          ? "<span style=\\"display:inline-block;background:#e11d48;color:#fff;font-size:10.5px;padding:1px 6px;border-radius:4px;margin-right:5px;\\">✓選択中</span>"',
    '          : "";',
    '        const conf = evaluatePlanOptionConflict64(rowOpt, pNum, planDetails, multiDocMap);',
    '        const unlockBtnHtml = conf.hasRawBlock',
    '          ? (state.unlockedConflicts[rowOpt.slotKey]',
    '              ? "<button type=\\"button\\" class=\\"btn-64\\" style=\\"margin-top:4px;background:#475569;font-size:10.5px;padding:2px 8px;\\" onclick=\\"toggleConflictUnlock64(\'" + rowOpt.slotKey + "\')\\">🔒 再ロックする</button>"',
    '              : "<button type=\\"button\\" class=\\"btn-64\\" style=\\"margin-top:4px;background:#7c3aed;font-size:11px;padding:3px 9px;\\" onclick=\\"toggleConflictUnlock64(\'" + rowOpt.slotKey + "\')\\">🔓 ロック解除して「AまたはB可能か」で両方交渉する</button>")',
    '          : "";',
    '',
    '        if (conf.status === "BLOCK") {',
    '          planHtmls.push(',
    '            "<div class=\\"plan-line plan-block\\" style=\\"" + markerStyle + "\\">" +',
    '              "<div style=\\"text-decoration:line-through;opacity:0.75;\\">" + markerBadge + "<b>" + m[1] + "</b>" + m[3] + "</div>" +',
    '              "<div class=\\"conflict-reason-box is-block\\">" + conf.reason + "<br>" + unlockBtnHtml + "</div>" +',
    '            "</div>"',
    '          );',
    '        } else if (conf.status === "WARN") {',
    '          planHtmls.push(',
    '            "<div class=\\"plan-line plan-warn\\" style=\\"" + markerStyle + "\\">" +',
    '              "<div>" + markerBadge + "<b>" + m[1] + "</b>" + m[3] + "</div>" +',
    '              "<div class=\\"conflict-reason-box is-warn\\">" + conf.reason + (unlockBtnHtml ? "<br>" + unlockBtnHtml : "") + "</div>" +',
    '            "</div>"',
    '          );',
    '        } else {',
    '          planHtmls.push("<div class=\\"plan-line\\" style=\\"" + markerStyle + "\\">" + markerBadge + "<b>" + m[1] + "</b>" + m[3] + "</div>");',
    '        }',
    '      } else if (m) {',
    '        planHtmls.push("<div class=\\"plan-line\\"><b>" + m[1] + "</b>" + m[3] + "</div>");',
    '      } else {',
    '        planHtmls.push("<div class=\\"plan-line\\">" + s + "</div>");',
    '      }',
    '    }',
    '  });',
    '',
    '  if (noteLines.length > 0) {',
    '    planHtmls.push("<div class=\\"note-line\\">" + noteLines.join("\\n") + "</div>");',
    '  }',
    '  return planHtmls.join("");',
    '}'
  ].join('\n');
}