/**
 * ============================================================================
 * 7c3_1_編集くん64_医師検索と行編集.gs
 * （パート3前半：ロック解除トグル・医師検索サジェスト・カスタム入力直結・行編集イベント）
 * ============================================================================
 */

function getHenshukun64ScriptPart3a_() {
  return [
    '// ★同時間帯・移動競合のロック解除トグル（「AまたはB可能でしょうか？」の選択的交渉を許可）',
    'function toggleConflictUnlock64(slotKey) {',
    '  if (!state.unlockedConflicts) state.unlockedConflicts = {};',
    '  state.unlockedConflicts[slotKey] = !state.unlockedConflicts[slotKey];',
    '  renderStageTable();',
    '  const row = state.slotRows.find(function(r) { return r.slotKey === slotKey; });',
    '  if (row) {',
    '    setStatus(',
    '      state.unlockedConflicts[slotKey]',
    '        ? "🔓 「" + row.clinicTitle + "」の他枠重複ロックを解除しました（『AまたはBどちらかで可能か』の選択的交渉として選べます）"',
    '        : "🔒 「" + row.clinicTitle + "」の他枠重複ロックを再び有効にしました。"',
    '      , "#ffc72c"',
    '    );',
    '  }',
    '}',
    '',
    '// ★既に特別時給の枠で「さらに加算」のロックを解除・再ロックするトグル',
    'function toggleExtraSpWageUnlock64(slotKey) {',
    '  if (!state.unlockedExtraSpWage) state.unlockedExtraSpWage = {};',
    '  state.unlockedExtraSpWage[slotKey] = !state.unlockedExtraSpWage[slotKey];',
    '  const row = state.slotRows.find(function(r) { return r.slotKey === slotKey; });',
    '  if (row && !state.unlockedExtraSpWage[slotKey]) {',
    '    // ロックに戻した場合は特別時給交渉タグを外す',
    '    row.curDecision = stripNegotiationSpWageTag64(row.curDecision);',
    '  }',
    '  renderStageTable();',
    '  onSlotEdit64(slotKey);',
    '}',
    '',
    'function onSearchDocInput64(slotKey) {',
    '  const inp = document.getElementById("srch_" + slotKey);',
    '  const drop = document.getElementById("sug_" + slotKey);',
    '  if (!inp || !drop) return;',
    '',
    '  const rawQ = inp.value.trim();',
    '  const q = normalizeSearchClient64(rawQ);',
    '  if (!q) {',
    '    drop.style.display = "none";',
    '    return;',
    '  }',
    '',
    '  let matches = state.doctorSearchList.filter(function(d) {',
    '    return d.norm.includes(q) || d.name.includes(rawQ);',
    '  });',
    '',
    '  if (q.length >= 2) {',
    '    const surname2 = q.slice(0, 2);',
    '    const surnameMatches = state.doctorSearchList.filter(function(d) {',
    '      return d.norm.slice(0, 2) === surname2 && !matches.some(function(m) { return m.name === d.name && m.licenseNo === d.licenseNo; });',
    '    });',
    '    matches = matches.concat(surnameMatches);',
    '  }',
    '',
    '  matches.sort(function(a, b) {',
    '    const aHas = a.licenseNo ? 1 : 0;',
    '    const bHas = b.licenseNo ? 1 : 0;',
    '    if (aHas !== bHas) return bHas - aHas;',
    '    return a.name.localeCompare(b.name, "ja");',
    '  });',
    '  matches = matches.slice(0, 15);',
    '',
    '  if (matches.length === 0) {',
    '    drop.innerHTML = "<div style=\\"padding:6px 10px;font-size:12px;color:#64748b;\\">該当する医師が見つかりません（下の欄に直接手入力も可能です）</div>";',
    '    drop.style.display = "block";',
    '    return;',
    '  }',
    '',
    '  // ★onmousedown + event.preventDefault() で検索欄のフォーカス外れによるクリック空振りを防止',
    '  drop.innerHTML = matches.map(function(d) {',
    '    const licBadge = d.licenseNo ? "医籍: " + d.licenseNo : "番号未登録";',
    '    const tagBadge = d.tag ? " [" + d.tag + "]" : "";',
    '    return "<div class=\\"suggest-item\\" onmousedown=\\"event.preventDefault(); pickDoctorFromSuggest64(\'" + slotKey + "\', \'" + d.name + "\', \'" + (d.licenseNo || "") + "\')\\">" +',
    '      "<span>👨‍⚕️ " + d.name + " 先生" + tagBadge + "</span>" +',
    '      "<span class=\\"suggest-lic\\">" + licBadge + "</span>" +',
    '    "</div>";',
    '  }).join("");',
    '  drop.style.display = "block";',
    '}',
    '',
    'function pickDoctorFromSuggest64(slotKey, docName, licenseNo) {',
    '  const row = state.slotRows.find(function(r) { return r.slotKey === slotKey; });',
    '  if (!row) return;',
    '',
    '  const actSelect = document.getElementById("act_" + slotKey);',
    '  const actionType = actSelect ? actSelect.value : "個別打診";',
    '  const conf = evaluateDoctorConflictWithOtherChosenRows64(row, docName, actionType === "移動打診", "");',
    '  if (conf.status === "BLOCK") {',
    '    if (!confirm("⚠️ " + docName + "先生は " + conf.reason + " です。\\nロックを解除して『AまたはBどちらかで可能か』の選択的交渉として追加しますか？")) {',
    '      return;',
    '    }',
    '    state.unlockedConflicts[slotKey] = true;',
    '  }',
    '',
    '  // ★医師を選択した際、プルダウンを「カスタム入力」・カスタム欄を表示状態に固定したまま反映',
    '  const selEl = document.getElementById("sel_" + slotKey);',
    '  const cbox = document.getElementById("cbox_" + slotKey);',
    '  if (selEl) selEl.value = "カスタム入力";',
    '  if (cbox) cbox.style.display = "block";',
    '',
    '  const cusInput = document.getElementById("cus_" + slotKey);',
    '  const srchInput = document.getElementById("srch_" + slotKey);',
    '  const drop = document.getElementById("sug_" + slotKey);',
    '',
    '  if (!Array.isArray(row.customDocs)) row.customDocs = [];',
    '  const existingIdx = row.customDocs.findIndex(function(d) { return d.name === docName; });',
    '  if (existingIdx >= 0) {',
    '    row.customDocs[existingIdx].actionType = actionType;',
    '    if (licenseNo) row.customDocs[existingIdx].licenseNo = licenseNo;',
    '  } else {',
    '    row.customDocs.push({ name: docName, licenseNo: licenseNo || "", actionType: actionType });',
    '  }',
    '',
    '  const phraseList = row.customDocs.map(function(d) { return d.name + "先生へ" + (d.actionType || "個別打診"); });',
    '  if (cusInput) cusInput.value = phraseList.join(" / ");',
    '',
    '  if (srchInput) srchInput.value = "";',
    '  if (drop) drop.style.display = "none";',
    '',
    '  const tagsBox = document.getElementById("tags_" + slotKey);',
    '  if (tagsBox) tagsBox.innerHTML = buildPickedDocsTagsHtml64(slotKey, row.customDocs);',
    '',
    '  onSlotEdit64(slotKey);',
    '}',
    '',
    'function onCustomActionTypeChange64(slotKey) {',
    '  const row = state.slotRows.find(function(r) { return r.slotKey === slotKey; });',
    '  if (!row || !Array.isArray(row.customDocs) || row.customDocs.length === 0) return;',
    '  const actSelect = document.getElementById("act_" + slotKey);',
    '  const newType = actSelect ? actSelect.value : "個別打診";',
    '  row.customDocs.forEach(function(d) { d.actionType = newType; });',
    '  const cusInput = document.getElementById("cus_" + slotKey);',
    '  if (cusInput) {',
    '    cusInput.value = row.customDocs.map(function(d) { return d.name + "先生へ" + (d.actionType || "個別打診"); }).join(" / ");',
    '  }',
    '  onSlotEdit64(slotKey);',
    '}',
    '',
    'function removeCustomDoc64(slotKey, idx) {',
    '  const row = state.slotRows.find(function(r) { return r.slotKey === slotKey; });',
    '  if (!row || !Array.isArray(row.customDocs)) return;',
    '',
    '  row.customDocs.splice(idx, 1);',
    '  const cusInput = document.getElementById("cus_" + slotKey);',
    '  if (cusInput) {',
    '    cusInput.value = row.customDocs.map(function(d) { return d.name + "先生へ" + (d.actionType || "個別打診"); }).join(" / ");',
    '  }',
    '  const tagsBox = document.getElementById("tags_" + slotKey);',
    '  if (tagsBox) tagsBox.innerHTML = buildPickedDocsTagsHtml64(slotKey, row.customDocs);',
    '',
    '  onSlotEdit64(slotKey);',
    '}',
    '',
    'function onSlotEdit64(slotKey) {',
    '  const row = state.slotRows.find(function(r) { return r.slotKey === slotKey; });',
    '  if (!row) return;',
    '',
    '  const wasBackup = isBackupDecision64(row.curDecision);',
    '  const selEl = document.getElementById("sel_" + slotKey);',
    '  const sel = selEl ? selEl.value : "";',
    '  const cbox = document.getElementById("cbox_" + slotKey);',
    '  const spbox = document.getElementById("spbox_" + slotKey);',
    '  const spamt = document.getElementById("spamt_" + slotKey);',
    '  const cusInput = document.getElementById("cus_" + slotKey);',
    '  const cmntInput = document.getElementById("cmnt_" + slotKey);',
    '  const stfSelect = document.getElementById("stf_" + slotKey);',
    '',
    '  if (cbox) cbox.style.display = (sel === "カスタム入力") ? "block" : "none";',
    '  if (spbox) spbox.style.display = (sel === "特別時給＋ステイ") ? "block" : "none";',
    '',
    '  if (sel !== "カスタム入力") {',
    '    row.customDocs = [];',
    '    row.customComment = "";',
    '    if (cusInput) cusInput.value = "";',
    '    if (cmntInput) cmntInput.value = "";',
    '    const tagsBox = document.getElementById("tags_" + slotKey);',
    '    if (tagsBox) tagsBox.innerHTML = "";',
    '  } else {',
    '    row.customComment = cmntInput ? cmntInput.value.trim() : "";',
    '  }',
    '',
    '  const multiDocMap = parseMultiDoctorPlansFromCol2_64(row.col2Plans);',
    '  let activePlanNums = [];',
    '  if (sel === "全案") activePlanNums = ["1", "2", "3"];',
    '  else if (sel.indexOf("案") !== -1) activePlanNums = sel.match(/[123]/g) || [];',
    '',
    '  let finalDec = sel;',
    '  if (sel === "") {',
    '    finalDec = "";',
    '  } else if (sel === "カスタム入力") {',
    '    // ★未入力時は「要検討」ではなく「カスタム入力(医師未選択)」として保持し、プルダウンのリセットを防ぐ',
    '    const cusText = cusInput ? cusInput.value.trim() : "";',
    '    finalDec = cusText || (row.customComment ? "カスタム対応" : "カスタム入力(医師未選択)");',
    '  } else if (sel === "特別時給＋ステイ") {',
    '    const amtVal = spamt ? spamt.value : "+2,000円";',
    '    finalDec = "特別時給(" + amtVal + ")＋ステイ";',
    '  } else if (activePlanNums.length > 0) {',
    '    const hasAnyMulti = activePlanNums.some(function(pNum) { return Boolean(multiDocMap[pNum]); });',
    '    if (hasAnyMulti) {',
    '      const builtParts = activePlanNums.map(function(pNum) {',
    '        if (!multiDocMap[pNum]) return "案" + pNum;',
    '        const msel = document.getElementById("mdoc_" + slotKey + "_" + pNum);',
    '        const pickedDoc = msel ? msel.value : "";',
    '        return "案" + pNum + "(" + (pickedDoc || "医師未選択") + ")";',
    '      });',
    '      finalDec = builtParts.join(", ");',
    '    }',
    '  }',
    '',
    '  const isStayLike = isStayLikeDecision64(finalDec);',
    '',
    '  // ★個別交渉時の「💰特別時給で交渉する」チェック状態を反映',
    '  if (finalDec && finalDec !== "要検討" && !finalDec.includes("医師未選択") && !isStayLike) {',
    '    const negChk = document.getElementById("negsp_chk_" + slotKey);',
    '    const negAmt = document.getElementById("negsp_amt_" + slotKey);',
    '    if (negChk && negChk.checked) {',
    '      const amtStr = negAmt ? negAmt.value : "+2,000円";',
    '      const isAlreadySp = String(row.timeAndWage || "").includes("特別時給");',
    '      finalDec += isAlreadySp ? ("【特別時給さらに" + amtStr + "加算交渉】") : ("【特別時給" + amtStr + "交渉】");',
    '    }',
    '  }',
    '',
    '  if (stfSelect) {',
    '    if (isStayLike) {',
    '      stfSelect.value = "";',
    '      stfSelect.disabled = true;',
    '      stfSelect.style.background = "#cbd5e1";',
    '      stfSelect.style.color = "#64748b";',
    '      stfSelect.style.cursor = "not-allowed";',
    '      stfSelect.style.opacity = "0.65";',
    '      if (stfSelect.options.length > 0) stfSelect.options[0].text = "(担当不要)";',
    '    } else {',
    '      stfSelect.disabled = false;',
    '      stfSelect.style.background = "";',
    '      stfSelect.style.color = "";',
    '      stfSelect.style.cursor = "";',
    '      stfSelect.style.opacity = "1";',
    '      if (stfSelect.options.length > 0) stfSelect.options[0].text = "(未定)";',
    '    }',
    '  }',
    '',
    '  const finalStaff = (isStayLike || !stfSelect) ? "" : stfSelect.value;',
    '',
    '  row.curDecision = finalDec;',
    '  row.curAssignee = finalStaff;',
    '',
    '  const isEdited = (row.curDecision !== row.origDecision) || (row.curAssignee !== row.origAssignee) || ((row.customComment || "") !== (row.origComment || ""));',
    '  if (isEdited) {',
    '    state.changedSlots[slotKey] = {',
    '      decision: finalDec,',
    '      assignee: finalStaff,',
    '      customComment: row.customComment || "",',
    '      customDocs: Array.isArray(row.customDocs) ? row.customDocs : [],',
    '      dateLabel: row.dateLabel,',
    '      clinicTitle: row.clinicTitle',
    '    };',
    '  } else {',
    '    delete state.changedSlots[slotKey];',
    '  }',
    '',
    '  const isNowBackup = isBackupDecision64(finalDec);',
    '  if (wasBackup !== isNowBackup) {',
    '    renderDateTabs();',
    '    renderStageTable();',
    '    updateEditCounter();',
    '    return;',
    '  }',
    '',
    '  state.slotRows.forEach(function(r) {',
    '    if (r.dateLabel !== state.activeDateTab || !isRowMatchRegionFilter(r)) return;',
    '    const rVs = getRowVisualState64(r);',
    '    const rSelEl = document.getElementById("sel_" + r.slotKey);',
    '    const rStfEl = document.getElementById("stf_" + r.slotKey);',
    '    const rTrEl = document.getElementById("tr_" + r.slotKey);',
    '    const rRstEl = document.getElementById("rst_" + r.slotKey);',
    '    const rAfterEl = document.getElementById("after_" + r.slotKey);',
    '    const rPlansTd = document.getElementById("plans_td_" + r.slotKey);',
    '    const rUnlockWrap = document.getElementById("unlock_wrap_" + r.slotKey);',
    '    const rMdocWrap = document.getElementById("mdoc_wrap_" + r.slotKey);',
    '    const rNegSpOuter = document.getElementById("negsp_outer_" + r.slotKey);',
    '',
    '    const built = buildDecisionOptionsAndSubBoxesHtml64(r);',
    '    if (rSelEl) {',
    '      rSelEl.innerHTML = built.decOpts;',
    '      rSelEl.className = "n64-select " + rVs.decSelClass;',
    '    }',
    '    if (rUnlockWrap) rUnlockWrap.innerHTML = built.conflictUnlockBarHtml;',
    '    if (rMdocWrap) rMdocWrap.innerHTML = built.multiDocBoxesHtml;',
    '    if (rNegSpOuter) rNegSpOuter.innerHTML = built.negSpWageBoxHtml;',
    '    if (rStfEl && !rVs.isStay) {',
    '      rStfEl.className = "n64-select " + rVs.stfSelClass;',
    '    }',
    '    if (rTrEl) {',
    '      rTrEl.className = rVs.rowClass;',
    '      rTrEl.setAttribute("style", rVs.rowInlineBg);',
    '    }',
    '    if (rRstEl) {',
    '      const rEd = (r.curDecision !== r.origDecision) || (r.curAssignee !== r.origAssignee) || ((r.customComment || "") !== (r.origComment || ""));',
    '      rRstEl.style.display = rEd ? "block" : "none";',
    '    }',
    '    if (rPlansTd) {',
    '      rPlansTd.innerHTML = formatPlansHtml64(r.col2Plans, r);',
    '    }',
    '    if (rAfterEl) {',
    '      rAfterEl.className = rVs.afterClass;',
    '      rAfterEl.setAttribute("style", rVs.afterInlineStyle);',
    '      rAfterEl.innerHTML = buildAfterDiffHtml64(r);',
    '    }',
    '  });',
    '',
    '  renderDateTabs();',
    '  updateEditCounter();',
    '}'
  ].join('\n');
}